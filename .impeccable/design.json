  "narrative": {
    "northStar": "The Preserved TalaCard Stage",
    "overview": "A Persian editing workspace surrounds the preserved TalaCard presentation. White panels, quiet gray workspace, charcoal type and restrained gold selection keep the supplied phone compositions and motion in the foreground. YekanX and RTL remain the shared identity across editor and player.",
    "keyCharacteristics": [
      "Persian RTL with extracted YekanX font files.",
      "White and gray editing chrome; charcoal actions and gold selection.",
      "Original six chapters and fourteen scenes retained as the app deck.",
      "Page-specific live preview with text, image and video controls."
    ],
    "rules": [
      {
        "name": "The Preserved Stage Rule",
        "body": "Extend the editing chrome around the incumbent presentation; retain its supplied phone frames, artwork and motion.",
        "section": "colors"
      },
      {
        "name": "The Gold State Rule",
        "body": "Use gold for selection, progress and playback emphasis; use charcoal for the save action.",
        "section": "colors"
      },
      {
        "name": "The Persian First Rule",
        "body": "Keep YekanX and RTL as the default; isolate time readouts and seek controls in LTR.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do retain the supplied TalaCard identity and original chapter/scene structure.",
      "Do keep the selected scene synchronized across list, inspector and stage.",
      "Do preserve the visible mobile save state and add-page control.",
      "Do use supplied images and videos with contain fitting by default; scene settings may explicitly choose another fit."
    ],
    "donts": [
      "Don't replace YekanX, RTL or the white/gray/charcoal/gold identity.",
      "Don't apply the phone's metallic depth or partner-brand teal to editor controls.",
      "Don't treat text inside raster app frames as editable live text."
    ]
